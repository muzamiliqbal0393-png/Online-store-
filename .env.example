# Copy to a PRIVATE .env file; never commit actual credentials.
# Direct Python launch: export these variables in your shell before startup.
# Compose reads .env for the substitutions in compose.yaml.
PUBLIC_BASE_URL=
PAYMENT_MODE=test
STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Credential presence does not enable wallet adapters. See PAYMENTS.md.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_HASH_KEY=
COOKIE_SECURE=0
STYLEHUB_ADMIN_EMAIL=admin@stylehub.local
STYLEHUB_ADMIN_PASSWORD=
